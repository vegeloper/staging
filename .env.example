POSTGRES_DB=dotone_trip
POSTGRES_USER=dotone_app
POSTGRES_PASSWORD=replace-with-64-char-hex

# Bind Postgres to loopback on the host. Never use 0.0.0.0 in production.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Public origin the browser uses. Production must be https://your-domain
APP_ORIGIN=http://localhost:3000

# Hostname only, used by Caddy on the production overlay (no scheme).
# APP_HOST=trip.example.com

# Used by Next.js on the host (`npm run dev`). Inside Compose, the app
# service builds DATABASE_URL from POSTGRES_* and the `postgres` hostname.
DATABASE_URL=postgresql://dotone_app:replace-with-64-char-hex@127.0.0.1:5432/dotone_trip

# require when Postgres is on another host / cloud and TLS is enabled
DATABASE_SSL=disable

UPLOAD_ROOT=./data/resumes
# Leave unset in Docker so Compose uses named volume dotone-trip-resumes-data.
# resume-init chowns uid 1000 automatically. Set only for a host bind:
# RESUME_HOST_PATH=./data/resumes
MAX_RESUME_BYTES=5242880

# Media library. Local `npm run dev` uses ./data/media. ClamAV is reached
# through /var/run/clamav/clamd.ctl when that socket exists, otherwise
# 127.0.0.1:3310 (the Compose clamav service publishes that on loopback).
# The app container sets CLAMAV_HOST=clamav and does not use this value.
MEDIA_ROOT=./data/media
# MEDIA_HOST_PATH=./data/media
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=
MAX_MEDIA_IMAGE_BYTES=8388608
MAX_MEDIA_VIDEO_BYTES=67108864

# Set true only when a trusted reverse proxy sits in front of the app.
TRUST_PROXY=false

# 32-byte values, Base64-encoded:
# node scripts/generate-prod-secrets.mjs
AUTH_PASSWORD_PEPPER=
PII_ENCRYPTION_KEY=

# Prefer `npm run db:bootstrap` (or `npm run docker:bootstrap`). It creates
# admin, operator, and creator in one shot and prints the passwords once.
# The variables below are only for the older `npm run db:seed` path.
# Do not leave them set after that command.
# SEED_ADMIN_PASSWORD=
# SEED_OPERATOR_PASSWORD=
# SEED_CREATOR_PASSWORD=
